#!/usr/bin/env python3
import sys
import os
import pty
import select
import socket
import ssl
import json
import base64
import struct
import fcntl
import termios
import signal
import shutil
import urllib.parse
import argparse

OPCODE_CONT = 0x0
OPCODE_TEXT = 0x1
OPCODE_BINARY = 0x2
OPCODE_CLOSE = 0x8
OPCODE_PING = 0x9
OPCODE_PONG = 0xA

class WebSocketClient:
    def __init__(self, url):
        parsed = urllib.parse.urlparse(url)
        self.is_ssl = parsed.scheme in ('wss', 'https')
        self.host = parsed.hostname or 'localhost'
        self.port = parsed.port or (443 if self.is_ssl else 80)
        self.path = parsed.path or '/'
        if parsed.query:
            self.path += '?' + parsed.query
        self.sock = None
        self.buffer = bytearray()

    def connect(self):
        raw_sock = socket.create_connection((self.host, self.port), timeout=15)
        if self.is_ssl:
            ctx = ssl.create_default_context()
            self.sock = ctx.wrap_socket(raw_sock, server_hostname=self.host)
        else:
            self.sock = raw_sock

        key = base64.b64encode(os.urandom(16)).decode('ascii')
        headers = [
            f"GET {self.path} HTTP/1.1",
            f"Host: {self.host}:{self.port}",
            "Upgrade: websocket",
            "Connection: Upgrade",
            f"Sec-WebSocket-Key: {key}",
            "Sec-WebSocket-Version: 13",
            "User-Agent: MuseCodeRemote-Client/1.0",
            "\r\n"
        ]
        self.sock.sendall("\r\n".join(headers).encode('utf-8'))

        response = b""
        while b"\r\n\r\n" not in response:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("Server closed connection during handshake")
            response += chunk

        head, rest = response.split(b"\r\n\r\n", 1)
        self.buffer.extend(rest)
        status_line = head.split(b"\r\n")[0].decode('utf-8', errors='replace')
        if "101" not in status_line:
            raise ConnectionError(f"WebSocket upgrade failed: {status_line}")

        self.sock.setblocking(False)

    def send_frame(self, payload, opcode=OPCODE_BINARY):
        if isinstance(payload, str):
            payload = payload.encode('utf-8')
            opcode = OPCODE_TEXT

        length = len(payload)
        header = bytearray()
        header.append(0x80 | opcode)

        mask_bit = 0x80
        if length <= 125:
            header.append(mask_bit | length)
        elif length <= 65535:
            header.append(mask_bit | 126)
            header.extend(struct.pack("!H", length))
        else:
            header.append(mask_bit | 127)
            header.extend(struct.pack("!Q", length))

        mask = os.urandom(4)
        header.extend(mask)

        masked_payload = bytearray(length)
        for i in range(length):
            masked_payload[i] = payload[i] ^ mask[i % 4]

        self.sock.sendall(header + masked_payload)

    def read_frames(self):
        try:
            chunk = self.sock.recv(16384)
            if chunk:
                self.buffer.extend(chunk)
            elif chunk == b"":
                return None
        except (BlockingIOError, ssl.SSLWantReadError):
            pass
        except Exception as e:
            return None

        frames = []
        while True:
            if len(self.buffer) < 2:
                break
            b1 = self.buffer[0]
            b2 = self.buffer[1]

            fin = (b1 & 0x80) != 0
            opcode = b1 & 0x0F
            is_masked = (b2 & 0x80) != 0
            payload_len = b2 & 0x7F

            offset = 2
            if payload_len == 126:
                if len(self.buffer) < offset + 2:
                    break
                payload_len = struct.unpack("!H", self.buffer[offset:offset+2])[0]
                offset += 2
            elif payload_len == 127:
                if len(self.buffer) < offset + 8:
                    break
                payload_len = struct.unpack("!Q", self.buffer[offset:offset+8])[0]
                offset += 8

            mask = None
            if is_masked:
                if len(self.buffer) < offset + 4:
                    break
                mask = self.buffer[offset:offset+4]
                offset += 4

            if len(self.buffer) < offset + payload_len:
                break

            raw_payload = self.buffer[offset:offset+payload_len]
            self.buffer = self.buffer[offset+payload_len:]

            if is_masked and mask:
                unmasked = bytearray(payload_len)
                for i in range(payload_len):
                    unmasked[i] = raw_payload[i] ^ mask[i % 4]
                payload = bytes(unmasked)
            else:
                payload = bytes(raw_payload)

            if opcode == OPCODE_PING:
                self.send_frame(payload, OPCODE_PONG)
            elif opcode == OPCODE_CLOSE:
                return None
            else:
                frames.append((opcode, payload))

        return frames

    def close(self):
        try:
            if self.sock:
                self.sock.close()
        except Exception:
            pass

def find_muse_binary():
    candidates = [
        shutil.which('muse'),
        os.path.expanduser('~/.local/bin/muse'),
        '/root/.local/bin/muse',
        '/usr/local/bin/muse',
        '/usr/bin/muse'
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None

def set_terminal_size(fd, cols, rows):
    try:
        winsize = struct.pack("HHHH", int(rows), int(cols), 0, 0)
        fcntl.ioctl(fd, termios.TIOCSWINSZ, winsize)
    except Exception:
        pass

def main():
    parser = argparse.ArgumentParser(description="Muse Code Remote (MCR) Daemon")
    parser.add_argument("--relay", default=os.environ.get("MCR_RELAY", "https://muse.ammarnashar.dev"),
                        help="Relay server URL (e.g., https://muse.example.com)")
    parser.add_argument("--token", default=os.environ.get("MCR_TOKEN", ""),
                        help="Custom session token (optional)")
    parser.add_argument("--cmd", default="",
                        help="Command to run (defaults to muse)")
    parser.add_argument("--dir", default=os.environ.get("MCR_DIR", os.getcwd()),
                        help="Working directory for the session")
    args = parser.parse_args()

    muse_bin = args.cmd or find_muse_binary()
    if not muse_bin:
        print("\033[31m[MCR Error] Muse Code executable ('muse') not found on this system.\033[0m")
        print("Please install Muse Code first or specify --cmd <path-to-muse>.")
        sys.exit(1)

    relay_url = args.relay.rstrip('/')
    ws_scheme = 'wss' if relay_url.startswith('https://') else 'ws'
    host_part = relay_url.split('://', 1)[-1]
    daemon_ws_url = f"{ws_scheme}://{host_part}/ws/daemon"

    print(f"\033[34m[MCR]\033[0m Connecting to relay {relay_url} ...")
    ws = WebSocketClient(daemon_ws_url)
    try:
        ws.connect()
    except Exception as e:
        print(f"\033[31m[MCR Connection Error]\033[0m Could not connect to relay: {e}")
        sys.exit(1)

    ws.send_frame(json.dumps({
        "type": "register",
        "token": args.token
    }), OPCODE_TEXT)

    session_token = None
    web_url = None
    while not session_token:
        frames = ws.read_frames()
        if frames is None:
            print("\033[31m[MCR Error]\033[0m Relay closed connection before registration.")
            sys.exit(1)
        for opcode, payload in frames:
            if opcode == OPCODE_TEXT:
                try:
                    data = json.loads(payload.decode('utf-8'))
                    if data.get('type') == 'registered':
                        session_token = data['token']
                        web_url = data.get('webUrl')
                except Exception:
                    pass

    print("\n" + "═" * 68)
    print("  \033[1;36m⚡ Muse Code Remote (MCR) Daemon\033[0m")
    print("═" * 68)
    print(f"  \033[1mSession Token:\033[0m  \033[1;32m{session_token}\033[0m")
    if web_url:
        print(f"  \033[1mDirect Web Link:\033[0m\033[4;34m{web_url}\033[0m")
    print(f"  \033[1mCommand:\033[0m        {muse_bin}")
    print(f"  \033[1mWorking Dir:\033[0m    {args.dir}")
    print("═" * 68)
    print("  \033[33mWaiting for browser connection...\033[0m (Press Ctrl+C to stop)\n")

    pty_master = None
    child_pid = None

    def cleanup(signum=None, frame=None):
        nonlocal child_pid, pty_master
        print("\n\033[33m[MCR] Shutting down daemon...\033[0m")
        if child_pid:
            try:
                os.kill(child_pid, signal.SIGTERM)
            except Exception:
                pass
        if pty_master:
            try:
                os.close(pty_master)
            except Exception:
                pass
        ws.close()
        sys.exit(0)

    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    def spawn_pty():
        nonlocal pty_master, child_pid
        master, slave = pty.openpty()
        flags = fcntl.fcntl(master, fcntl.F_GETFL)
        fcntl.fcntl(master, fcntl.F_SETFL, flags | os.O_NONBLOCK)

        pid = os.fork()
        if pid == 0:
            os.close(master)
            os.setsid()
            os.dup2(slave, 0)
            os.dup2(slave, 1)
            os.dup2(slave, 2)
            os.close(slave)

            env = os.environ.copy()
            env['TERM'] = 'xterm-256color'
            env['COLORTERM'] = 'truecolor'
            env['LANG'] = 'C.UTF-8'

            try:
                os.chdir(args.dir)
            except Exception:
                pass

            os.execvpe(muse_bin, [muse_bin], env)
        else:
            os.close(slave)
            pty_master = master
            child_pid = pid
            print(f"\033[32m[MCR]\033[0m Browser connected! Muse Code started (PID: {pid}).")

    try:
        while True:
            rlist = [ws.sock]
            if pty_master:
                rlist.append(pty_master)

            readable, _, _ = select.select(rlist, [], [], 0.1)

            if ws.sock in readable:
                frames = ws.read_frames()
                if frames is None:
                    print("\033[31m[MCR] Relay closed connection.\033[0m")
                    break

                for opcode, payload in frames:
                    if opcode == OPCODE_TEXT:
                        try:
                            msg = json.loads(payload.decode('utf-8'))
                            msg_type = msg.get('type')
                            if msg_type == 'client_connected':
                                if not child_pid:
                                    spawn_pty()
                            elif msg_type == 'client_disconnected':
                                print("\033[33m[MCR]\033[0m Browser disconnected. Session kept alive for reconnection.")
                            elif msg_type == 'resize':
                                cols = msg.get('cols', 100)
                                rows = msg.get('rows', 30)
                                if pty_master:
                                    set_terminal_size(pty_master, cols, rows)
                        except Exception:
                            if pty_master:
                                try:
                                    os.write(pty_master, payload)
                                except Exception:
                                    pass
                    elif opcode == OPCODE_BINARY:
                        if pty_master:
                            try:
                                os.write(pty_master, payload)
                            except Exception:
                                pass

            if pty_master and pty_master in readable:
                try:
                    data = os.read(pty_master, 4096)
                    if data:
                        ws.send_frame(data, OPCODE_BINARY)
                    else:
                        print("\033[33m[MCR] Muse Code process ended.\033[0m")
                        break
                except BlockingIOError:
                    pass
                except OSError:
                    print("\033[33m[MCR] Muse Code process closed terminal.\033[0m")
                    break

            if child_pid:
                pid, status = os.waitpid(child_pid, os.WNOHANG)
                if pid == child_pid:
                    print(f"\033[33m[MCR] Muse Code exited with status {status}.\033[0m")
                    break

    finally:
        cleanup()

if __name__ == '__main__':
    main()
